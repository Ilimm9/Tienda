{{define "titulo"}}Te invitaron a {{.NombreNegocio}}{{end}}
{{define "avance"}}{{.NombreNegocio}} te invitó a colaborar en {{.NombreApp}}. Acepta antes de {{.Horas}} {{if eq .Horas 1}}hora{{else}}horas{{end}}.{{end}}
{{define "contenido"}}
<tr>
  <td class="contenido" style="padding:16px 48px 8px;">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;letter-spacing:-0.5px;color:#172554;">Te invitaron a {{.NombreNegocio}}</h1>
    <p style="margin:0;font-size:15px;line-height:1.6;color:#334155;">Hola, {{.NombreInvitado}}. {{.NombreNegocio}} te invitó a colaborar en {{.NombreApp}}.</p>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:24px 48px;">
    <a href="{{.Enlace}}" class="boton" style="display:inline-block;padding:15px 28px;background-color:#4f46c8;color:#ffffff;font-size:15px;font-weight:bold;line-height:1;text-decoration:none;border-radius:10px;">Aceptar invitación</a>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:0 48px 20px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td bgcolor="#f8eac1" style="padding:12px 14px;background-color:#f8eac1;border:1px solid #eed9a0;border-radius:10px;color:#6b4a00;font-size:13px;line-height:1.5;">
          La invitación vence en <strong>{{.Horas}} {{if eq .Horas 1}}hora{{else}}horas{{end}}</strong>.
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:0 48px 24px;font-size:14px;line-height:1.6;color:#5b6478;">
    <p style="margin:0 0 12px;">Si el botón no funciona, copia este enlace en tu navegador:</p>
    <p style="margin:0 0 12px;word-break:break-all;"><a href="{{.Enlace}}" style="color:#3f37a8;">{{.Enlace}}</a></p>
    <p style="margin:0;">Si no esperabas esta invitación, ignora este correo.</p>
  </td>
</tr>
{{end}}
