{{define "titulo"}}Te invitaron a {{.NombreNegocio}}{{end}}
{{define "contenido"}}
<tr>
  <td class="contenido" style="padding:16px 48px 8px;">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.3;color:#111c32;">Te invitaron a {{.NombreNegocio}}</h1>
    <p style="margin:0;font-size:15px;line-height:1.6;">Hola, {{.NombreInvitado}}. {{.NombreNegocio}} te invitó a colaborar en {{.NombreApp}}.</p>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:24px 48px;">
    <a href="{{.Enlace}}" style="display:inline-block;padding:14px 28px;background-color:#2864e9;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;border-radius:10px;">Aceptar invitación</a>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:0 48px 24px;font-size:14px;line-height:1.6;color:#475569;">
    <p style="margin:0 0 12px;">La invitación vence en {{.Dias}} {{if eq .Dias 1}}día{{else}}días{{end}}. Si el botón no funciona, copia este enlace en tu navegador:</p>
    <p style="margin:0 0 12px;word-break:break-all;"><a href="{{.Enlace}}" style="color:#1d4fc5;">{{.Enlace}}</a></p>
    <p style="margin:0;">Si no esperabas esta invitación, ignora este correo.</p>
  </td>
</tr>
{{end}}
