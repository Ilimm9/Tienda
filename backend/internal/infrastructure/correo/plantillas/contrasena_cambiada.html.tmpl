{{define "titulo"}}Tu contraseña cambió{{end}}
{{define "avance"}}La contraseña de tu cuenta de {{.NombreApp}} se cambió. Si no fuiste tú, restablécela de inmediato.{{end}}
{{define "contenido"}}
<tr>
  <td class="contenido" style="padding:16px 48px 16px;">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;letter-spacing:-0.5px;color:#172554;">Tu contraseña cambió</h1>
    <p style="margin:0;font-size:15px;line-height:1.6;color:#334155;">La contraseña de tu cuenta de {{.NombreApp}} se cambió correctamente y cerramos todas tus sesiones abiertas.</p>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:0 48px 24px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td bgcolor="#fff1f1" style="padding:12px 14px;background-color:#fff1f1;border:1px solid #f5c9c9;border-radius:10px;color:#bd2525;font-size:13px;line-height:1.5;">
          <strong>¿No fuiste tú?</strong> <a href="{{.EnlaceRecuperacion}}" style="color:#bd2525;font-weight:bold;">Restablece tu contraseña</a> de inmediato.
        </td>
      </tr>
    </table>
  </td>
</tr>
{{end}}
