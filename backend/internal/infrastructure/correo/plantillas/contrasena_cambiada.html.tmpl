  <td class="contenido" style="padding:16px 48px 24px;">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.3;color:#111c32;">Tu contraseña cambió</h1>
    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">La contraseña de tu cuenta de {{.NombreApp}} se cambió correctamente y cerramos todas tus sesiones abiertas.</p>
    <p style="margin:0;font-size:14px;line-height:1.6;color:#475569;">Si no fuiste tú, <a href="{{.EnlaceRecuperacion}}" style="color:#1d4fc5;">restablece tu contraseña</a> de inmediato.</p>
  </td>
</tr>
{{end}}
