{{define "titulo"}}Verifica tu correo{{end}}
{{define "avance"}}Tu código de verificación es {{.Codigo}}. Vence en {{.Minutos}} minutos.{{end}}
{{define "contenido"}}
<tr>
  <td class="contenido" style="padding:16px 48px 8px;">
    <h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;letter-spacing:-0.5px;color:#172554;">Verifica tu correo</h1>
    <p style="margin:0;font-size:15px;line-height:1.6;color:#334155;">Usa este código para activar tu cuenta de {{.NombreApp}}.</p>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:16px 48px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center" bgcolor="#eceafb" style="padding:24px 16px;background-color:#eceafb;border:1px solid #dcd8f6;border-radius:12px;">
          <div style="margin-bottom:8px;color:#3f37a8;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Código de verificación</div>
          <div class="codigo" style="color:#172554;font-family:'Courier New',Courier,monospace;font-size:36px;font-weight:bold;letter-spacing:8px;">{{.Codigo}}</div>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="contenido" style="padding:8px 48px 24px;font-size:14px;line-height:1.6;color:#5b6478;">
    <p style="margin:0 0 12px;">El código vence en <strong style="color:#172554;">{{.Minutos}} minutos</strong>. No lo compartas con nadie.</p>
    <p style="margin:0;">Si no creaste una cuenta, ignora este correo.</p>
  </td>
</tr>
{{end}}
