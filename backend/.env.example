APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=4200
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tienda
DB_SSLMODE=disable
JWT_SECRET=change-this-secret-in-development
JWT_EXPIRATION=24h
SESSION_DURATION=24h
SESSION_REMEMBER_DURATION=720h
SESSION_REMEMBER_IDLE=168h
SESSION_TOUCH_INTERVAL=5m
SESSION_RETENTION=168h
SESSION_CLEANUP_INTERVAL=1h
OTP_HMAC_SECRET=development-only-change-otp-secret
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_WAIT=1m
OTP_HOURLY_SEND_MAX=5
LOGIN_HEADER_IMAGE_URL=https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=900&q=80
FRONTEND_URL=http://localhost:4200
PRECIOCHECK_API_KEY=
PRECIOCHECK_BASE_URL=https://preciocheck.com/api/v1
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial
SEED_ADMIN=false

# Correo transaccional (capabilities/07-servicio-correo-transaccional).
# Desarrollo: Mailpit, bandeja en http://localhost:8025, sin autenticación ni TLS.
# Producción (Amazon SES por SMTP):
#   SMTP_HOST=email-smtp.<region>.amazonaws.com   (SES > SMTP settings > SMTP endpoint)
#   SMTP_PORT=587  SMTP_TLS=starttls
#   SMTP_USERNAME / SMTP_PASSWORD = credenciales SMTP de SES (no son access keys de IAM)
#   MAIL_FROM=no-reply@mergemakers.com   (dominio verificado en SES)
#   Región vigente del proyecto: us-east-2 (US East, Ohio)
SMTP_HOST=localhost
SMTP_PORT=1025
# none | starttls | tls
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s
MAIL_FROM=no-reply@tienda.local
MAIL_FROM_NAME=Tienda
# Opcional: buzón que sí se lee para respuestas.
MAIL_REPLY_TO=
# Opcional: configuration set de SES; vacío no envía la cabecera.
SES_CONFIGURATION_SET=
# Vigencia del enlace de recuperación de contraseña.
PASSWORD_RESET_TTL=30m
