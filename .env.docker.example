# Variables de docker-compose.yml
# Uso: cp .env.docker.example .env y completar secretos solo en `.env`.
# Nunca copiar credenciales reales a este archivo ni enviarlo con valores sensibles.
#
# Nota: este archivo configura los CONTENEDORES. El archivo backend/.env
# sigue sirviendo para `go run ./cmd/api` fuera de Docker y no se usa aqui
# (backend/.dockerignore lo excluye de la imagen a proposito).

# --- Obligatoria: el compose falla si esta vacia ---
# Generar con: openssl rand -base64 32
JWT_SECRET=

# --- Puertos publicados en el host ---
WEB_PORT=8090        # nginx: la app completa (frontend + /api)
DB_PUBLIC_PORT=5433  # Postgres, para conectarse con un cliente local
PGADMIN_PORT=5052    # solo con: docker compose --profile tools up -d

# --- Base de datos ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tienda

# --- Aplicacion ---
# "docker" = sin datos semilla y sin cookie Secure (correcto sobre HTTP local).
# Cambiar a "production" solo detras de HTTPS real.
# Usar "development" una vez si se quieren los datos semilla de desarrollo.
APP_ENV=docker
JWT_EXPIRATION=24h
FRONTEND_URL=http://localhost:8090
LOGIN_HEADER_IMAGE_URL=https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=900&q=80

# --- Sesiones y códigos de seguridad ---
SESSION_DURATION=24h
SESSION_REMEMBER_DURATION=720h
SESSION_REMEMBER_IDLE=168h
SESSION_TOUCH_INTERVAL=5m
SESSION_RETENTION=168h
SESSION_CLEANUP_INTERVAL=1h
# Generar un valor distinto de JWT_SECRET: openssl rand -base64 32
OTP_HMAC_SECRET=development-only-change-otp-secret
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_WAIT=1m
OTP_HOURLY_SEND_MAX=5
PASSWORD_RESET_TTL=30m

# --- Correo transaccional ---
# Valores locales: Mailpit en http://localhost:8025, sin autenticacion ni TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s
MAIL_FROM=no-reply@tienda.local
MAIL_FROM_NAME=Tienda
MAIL_REPLY_TO=
SES_CONFIGURATION_SET=

# Amazon SES por SMTP en US East (Ohio), us-east-2:
# SMTP_HOST=email-smtp.us-east-2.amazonaws.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=<SMTP Username del CSV de SES; no el nombre del usuario IAM>
# SMTP_PASSWORD=<SMTP Password del CSV de SES>
# MAIL_FROM=no-reply@mergemakers.com
# MAIL_REPLY_TO=<buzon real de soporte>
# SES_CONFIGURATION_SET=<opcional; dejar vacio si no existe>

# --- Integraciones externas ---
PRECIOCHECK_API_KEY=
PRECIOCHECK_BASE_URL=https://preciocheck.com/api/v1
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial

# --- pgAdmin (perfil "tools") ---
PGADMIN_EMAIL=admin@tienda.com
PGADMIN_PASSWORD=admin123

# Con APP_ENV=docker la base arranca vacia: crear el primer usuario con
# POST http://localhost:8090/api/v1/auth/register
