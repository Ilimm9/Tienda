# Variables de docker-compose.yml
# Uso:  cp .env.docker.example .env  y editar JWT_SECRET
#
# Nota: este archivo configura los CONTENEDORES. El archivo backend/.env
# sigue sirviendo para `go run ./cmd/api` fuera de Docker y no se usa aqui
# (backend/.dockerignore lo excluye de la imagen a proposito).

# --- Obligatoria: el compose falla si esta vacia ---
# Generar con: openssl rand -base64 32
JWT_SECRET=

# --- Puertos publicados en el host ---
WEB_PORT=8090        # nginx: la app completa (frontend + /api)
DB_PUBLIC_PORT=5433  # Postgres, para conectarse con un cliente local
PGADMIN_PORT=5052    # solo con: docker compose --profile tools up -d

# --- Base de datos ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tienda

# --- Aplicacion ---
# "docker" = sin datos semilla y sin cookie Secure (correcto sobre HTTP local).
# Cambiar a "production" solo detras de HTTPS real.
# Usar "development" una vez si se quieren los datos semilla de desarrollo.
APP_ENV=docker
JWT_EXPIRATION=24h
FRONTEND_URL=http://localhost:8090
LOGIN_HEADER_IMAGE_URL=https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=900&q=80

# --- Integraciones externas ---
PRECIOCHECK_API_KEY=
PRECIOCHECK_BASE_URL=https://preciocheck.com/api/v1
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial

# --- pgAdmin (perfil "tools") ---
PGADMIN_EMAIL=admin@tienda.com
PGADMIN_PASSWORD=admin123

# Con APP_ENV=docker la base arranca vacia: crear el primer usuario con
# POST http://localhost:8090/api/v1/auth/register
