# Copiar como `.env.production` únicamente en el servidor y ejecutar:
#   chmod 600 .env.production
# Nunca guardar valores reales en Git, capturas, chat o correo.

APP_ENV=production
FRONTEND_URL=https://stockion.mergemakers.com

# Base PostgreSQL privada. Generar contraseña: openssl rand -base64 36
DB_USER=stockion
DB_PASSWORD=
DB_NAME=stockion

# Sesiones y OTP. Generar secreto: openssl rand -base64 48
SESSION_DURATION=24h
SESSION_REMEMBER_DURATION=720h
SESSION_REMEMBER_IDLE=168h
SESSION_TOUCH_INTERVAL=5m
SESSION_RETENTION=168h
SESSION_CLEANUP_INTERVAL=1h
OTP_HMAC_SECRET=
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_WAIT=1m
OTP_HOURLY_SEND_MAX=5
PASSWORD_RESET_TTL=30m

# Amazon SES SMTP, región us-east-2.
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s
MAIL_FROM=no-reply@mergemakers.com
MAIL_FROM_NAME=Stockion
MAIL_REPLY_TO=
SES_CONFIGURATION_SET=

# Integraciones opcionales.
LOGIN_HEADER_IMAGE_URL=
PRECIOCHECK_API_KEY=
PRECIOCHECK_BASE_URL=https://preciocheck.com/api/v1
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial

# Archivo local con sólo el token del túnel, permisos 0600.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
